# ===========================================================================
# Visit Imedwan — environment configuration (template)
# Copy to `.env` for local development. NEVER commit real secrets.
# See docs/deployment.md for production guidance.
# ===========================================================================

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:3000

# --- Database (PostgreSQL) -------------------------------------------------
# Local embedded PostgreSQL via `npm run db:start` (port 5433).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/visit_imedwan
# Separate database used by integration tests (never the dev/prod DB).
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/visit_imedwan_test

# --- Authentication / sessions --------------------------------------------
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=dev-only-change-me-000000000000000000000000000000000000000000
SESSION_COOKIE_NAME=vi_session
SESSION_TTL_HOURS=720

# --- Seeding & local verification -------------------------------------------
# prisma/seed.ts creates the dev admin from ADMIN_PASSWORD (no default ships).
ADMIN_EMAIL=admin@visitimedwan.local
ADMIN_PASSWORD=
# Local verify-*.mjs scripts read these and exit if unset.
E2E_ADMIN_EMAIL=admin@visitimedwan.local
E2E_ADMIN_PASSWORD=

# --- Payments (see docs/payments.md) ---------------------------------------
# Provider key from the payment abstraction registry.
# "none"  = checkout clearly reports that payments are not configured.
# "mock"  = development/testing only; never use in production.
PAYMENT_PROVIDER=none
PAYMENT_WEBHOOK_SECRET=

# --- Storage (see docs/media.md) -------------------------------------------
# "local" (development) | "s3" (production, S3-compatible)
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=.data/media
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# --- Mail (see docs/notifications.md) --------------------------------------
# "console" (development: emails are logged, never faked as delivered)
# "smtp" (production)
MAIL_DRIVER=console
MAIL_FROM=hello@visitimedwan.example
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- Map provider (see docs/maps.md) ---------------------------------------
# "none" | "osm" | "mapbox" | "google" — coordinates render only when verified.
MAP_PROVIDER=none
MAPBOX_TOKEN=
GOOGLE_MAPS_API_KEY=

# --- Observability ---------------------------------------------------------
LOG_LEVEL=info
